generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ──────────────────────────────────────────────────────────────
model User {
  id               Int           @id @default(autoincrement())
  username         String        @unique
  email            String        @unique
  password         String
  xp               Int           @default(0)
  level            Int           @default(1)
  streakCurrent    Int           @default(0)  @map("streak_current")
  streakBest       Int           @default(0)  @map("streak_best")
  lastActiveDate   DateTime?     @map("last_active_date")
  createdAt        DateTime      @default(now())

  userMissions     UserMission[]
  achievements     Achievement[]
  xpEvents         XpEvent[]

  @@map("User")
}

// ── Worlds ─────────────────────────────────────────────────────────────
model World {
  id                 Int       @id @default(autoincrement())
  name               String
  orderIndex         Int       @unique @map("order_index")
  unlockRequirement  Int       @default(0)  @map("unlock_requirement")
  // (number of missions in previous world required to unlock this one)

  missions           Mission[]
}

// ── Missions ───────────────────────────────────────────────────────────
model Mission {
  id             Int           @id @default(autoincrement())
  title          String
  description    String        @default("")
  worldId        Int           @map("world_id")
  xpReward       Int           @default(50)  @map("xp_reward")
  orderIndex     Int           @map("order_index")
  type           MissionType   @default(mission)
  command        String        @default("")
  expectedOutput String        @default("") @map("expected_output")

  world          World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  userMissions   UserMission[]

  @@map("Mission")
}

enum MissionType {
  mission
  boss
}

// ── User Mission Progress ──────────────────────────────────────────────
model UserMission {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  missionId   Int      @map("mission_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("UserMission")
}

// ── XP Events (for weekly leaderboard) ───────────────────────────────
model XpEvent {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  amount    Int
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("XpEvent")
}

// ── Achievements ──────────────────────────────────────────────────────
model Achievement {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  badge    String
  earnedAt DateTime @default(now()) @map("earned_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Achievement")
}
